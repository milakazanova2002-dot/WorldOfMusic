# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=wom_db
POSTGRES_USER=wom_user
POSTGRES_PASSWORD=change_me
# Локально (без Docker): localhost
# В docker-compose (локально и на проде): db  — имя сервиса в docker-compose.yml
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (кеш) ---
# Локально (без Docker): localhost
# В docker-compose (локально и на проде): redis — имя сервиса
REDIS_HOST=redis
REDIS_PORT=6379

# --- Django ---
# Сгенерировать новый ключ:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me
# На проде ОБЯЗАТЕЛЬНО False
DEBUG=True

# Список доменов/IP, с которых можно открывать сайт, через запятую, без пробелов.
# Локально: 127.0.0.1,localhost
# На проде: ваш-домен.ru,www.ваш-домен.ru
ALLOWED_HOSTS=127.0.0.1,localhost

# Нужно для защиты форм (CSRF) при работе через HTTPS на реальном домене.
# На проде: https://ваш-домен.ru,https://www.ваш-домен.ru
# Локально можно оставить пустым.
CSRF_TRUSTED_ORIGINS=

# --- Google OAuth ---
# Получить в Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Локально: http://127.0.0.1:8000/accounts/google/callback/
# На проде: https://ваш-домен.ru/accounts/google/callback/
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/
